FROM node:20-slim

WORKDIR /app

# Install runtime libraries required for node-canvas on Debian slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcairo2 \
    libpango-1.0-0 \
    libjpeg62-turbo \
    libgif7 \
    librsvg2-2 \
    libpixman-1-0 \
    libfreetype6 \
    fontconfig \
 && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install

# Bundle Tesseract language files locally (avoid CDN fetch at runtime).
RUN mkdir -p /app/backend/tessdata && \
  cp node_modules/@tesseract.js-data/eng/4.0.0/eng.traineddata.gz /app/backend/tessdata/ && \
  cp node_modules/@tesseract.js-data/hin/4.0.0/hin.traineddata.gz /app/backend/tessdata/

COPY . .

EXPOSE 5000

CMD ["node", "backend/src/index.js"]
